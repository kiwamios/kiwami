# Kiwami dev VM — stable command interface.
# Implementation lives in scripts/; these recipe names are the contract.

set shell := ["bash", "-uc"]

iso_url := "https://releases.nixos.org/nixos/26.05/nixos-26.05.8639.c5c4a43b0e80/nixos-minimal-26.05.8639.c5c4a43b0e80-aarch64-linux.iso"
iso_path := "iso/nixos-minimal-26.05-aarch64.iso"

# List available commands
default:
    @just --list --unsorted

# --- lifecycle ---------------------------------------------------------

# Download the NixOS installer ISO (skipped if present)
fetch-iso:
    @mkdir -p iso
    @test -f {{iso_path}} && echo "iso present" || curl -fL --retry 3 -C - -o {{iso_path}} "{{iso_url}}"

# Wipe the disk and do a full unattended NixOS install
install: fetch-iso
    ./scripts/install.sh

# Build the aarch64 installer image. This runs inside the guest: macOS cannot
# build Linux derivations at all, so unlike every other step in this loop it
# cannot happen on the host. Produces the -test variant, which carries the
# harness key so `just vm install-test` can drive it.
build-iso: push
    @./scripts/vmssh 'nix build ~/kiwami#nixosConfigurations.installer-aarch64-test.config.system.build.isoImage --print-build-logs 2>&1 | tail -3'
    @mkdir -p iso
    @echo "copying image out (~1.5G)..."
    @./scripts/vmssh 'cat ~/result/iso/*.iso' > iso/kiwami-installer-aarch64.iso
    @ls -lh iso/kiwami-installer-aarch64.iso

# The shipped installer image, which starts the wizard by itself.
#
# Not the -test one: that pre-creates the marker the autostart checks, so it
# lands at a shell - which is right for `just vm install-test`, which types
# `kiwami install` with flags, and fatal for `just vm guided-test`, whose
# first assertion is that nobody had to type anything. The guided test was
# booting the image built never to start on its own, and had been failing on
# that for as long as both existed.
#
# No harness key here, and none needed: the guided test drives the serial
# console rather than ssh.
build-iso-guided: push
    @./scripts/vmssh 'nix build ~/kiwami#nixosConfigurations.installer-aarch64.config.system.build.isoImage --print-build-logs 2>&1 | tail -3'
    @mkdir -p iso
    @echo "copying image out (~1.5G)..."
    @./scripts/vmssh 'cat ~/result/iso/*.iso' > iso/kiwami-installer-guided-aarch64.iso
    @ls -lh iso/kiwami-installer-guided-aarch64.iso

# Boot with the installer's scratch disks attached (empty NVMe, a partitioned
# disk, and one too small) so `just vm install-test` has something to enumerate
start-test-disks:
    @TEST_DISKS=1 ./scripts/start-vm.sh run headless

# Boot the installer ISO in a window, on a throwaway disk, to walk through
# `kiwami install` by hand the way a person would. Leaves the dev VM's own
# disk alone; only one VM runs at a time, so this stops the other.
practice: fetch-iso
    @mkdir -p disks
    @test -f disks/practice.qcow2 || qemu-img create -f qcow2 disks/practice.qcow2 40G
    @cp -f "$(brew --prefix)/share/qemu/edk2-arm-vars.fd" disks/practice-vars.fd
    # The Kiwami image when it exists, otherwise the stock NixOS one. Practising
    # against the stock ISO cannot exercise anything we ship - kiwami is not on
    # it - so the whole point is lost unless the built image is used.
    @test -f iso/kiwami-installer-aarch64.iso \
      && echo "using the Kiwami image" || echo "no Kiwami image; falling back to the stock ISO (run: just vm build-iso)"
    @ISO=$(test -f $PWD/iso/kiwami-installer-aarch64.iso && echo $PWD/iso/kiwami-installer-aarch64.iso || echo $PWD/iso/nixos-minimal-26.05-aarch64.iso) \
      DISK=$PWD/disks/practice.qcow2 VARS=$PWD/disks/practice-vars.fd \
      QMP_SOCK=/tmp/kiwami-practice-qmp.sock SERIAL_SOCK=/tmp/kiwami-practice-serial.sock \
      SSH_PORT=2223 ./scripts/start-vm.sh install gui
    @printf '\nA window is opening. The image carries kiwami, so at the prompt:\n\n'
    @printf '  sudo kiwami remote      join a tailnet (opens a URL to approve elsewhere)\n'
    @printf '  sudo kiwami net         get online\n'
    @printf '  sudo kiwami install     walk the installer\n\n'
    @printf 'Start over any time with:  just vm practice-reset\n\n'

# Throw away the practice disk so the next run starts from blank hardware
practice-reset:
    @rm -f disks/practice.qcow2 disks/practice-vars.fd && echo "practice disk removed"

# Boot the built Kiwami image with the scratch disks attached, so the matrix
# runs against the media people actually boot rather than the stock NixOS ISO.
#
# Its own firmware variables: booting from CD rewrites the boot order, and
# sharing the file leaves the installed system dropping into an EFI shell the
# next time it starts.
start-iso-test:
    @test -f iso/kiwami-installer-aarch64.iso || { echo "no image; run: just vm build-iso"; exit 1; }
    @cp -f "$(brew --prefix)/share/qemu/edk2-arm-vars.fd" disks/iso-vars.fd
    @TEST_DISKS=1 ISO=$PWD/iso/kiwami-installer-aarch64.iso VARS=$PWD/disks/iso-vars.fd \
      ./scripts/start-vm.sh install headless

# Install an encrypted machine on its own disk and boot it. The only LUKS
# claim evaluation cannot make: that it asks for a passphrase and comes up.
luks-test: fetch-iso
    ./scripts/luks-test.sh

# Install an ephemeral-root machine on its own disk and prove the root is
# actually wiped: a rollback that silently does nothing also boots.
ephemeral-test: fetch-iso
    ./scripts/ephemeral-test.sh

# Both at once. They were built separately and never ran together, which hid
# the rollback naming the root partition on a machine whose filesystem lives
# inside a LUKS container.
luks-ephemeral-test: fetch-iso
    ./scripts/luks-ephemeral-test.sh

# Drive the guided installer from a cold boot the way a person does. Stops at
# the confirmation, so it never installs: every guided-flow bug so far was in
# the conversation, before anything was written.
guided-test:
    @python3 ./scripts/guided-test.py

# --relayout rewrites a host's disk.nix, and aborting the review puts it back.
# Stops before formatting, so it costs a couple of minutes and erases nothing.
relayout-test: fetch-iso
    ./scripts/relayout-test.sh

# Run the installer test matrix (needs start-test-disks)
install-test:
    @./scripts/install-test.sh

# Same matrix, against the live image (needs start-iso-test)
install-test-iso:
    @ON_ISO=1 ./scripts/install-test.sh

# Boot the installed system (headless, detached)
start:
    ./scripts/start-vm.sh run headless

# Boot with a window you can click in
gui:
    ./scripts/start-vm.sh run gui

# Boot from the installer ISO instead of the disk
boot-iso: fetch-iso
    ./scripts/start-vm.sh install headless

# Shut the VM down
stop:
    ./scripts/stop-vm.sh

# Stop then start
restart: stop start

# Is the VM up, and on which channels?
status:
    @pgrep -f qemu-system-aarch64 >/dev/null && echo "qemu:    running" || echo "qemu:    stopped"
    @test -S /tmp/kiwami-qmp.sock && echo "qmp:     /tmp/kiwami-qmp.sock" || echo "qmp:     -"
    @test -S /tmp/kiwami-serial.sock && echo "serial:  /tmp/kiwami-serial.sock" || echo "serial:  -"
    @./scripts/vmssh 'echo "ssh:     ok — $(hostname) $(uname -m) — $(systemctl is-system-running)"' 2>/dev/null || echo "ssh:     unreachable"

# --- flake -------------------------------------------------------------

# Copy the flake into the guest at ~/kiwami
# COPYFILE_DISABLE stops macOS tar emitting AppleDouble "._" files.
# Staged then rsync'd rather than `rm -rf && extract`: the configs are
# out-of-store symlinks into this tree, so deleting it makes them dangle. A
# compositor or shell that reloads during that window reads a missing file.
push:
    @cd .. && COPYFILE_DISABLE=1 tar --no-xattrs --exclude='cli/target' -cf - flake.nix flake.lock hosts modules config shell cli vm/keys \
        | ./vm/scripts/vmssh 'rm -rf ~/.kiwami-staging && mkdir -p ~/.kiwami-staging ~/kiwami \
            && tar xf - -C ~/.kiwami-staging \
            && rsync -a --delete ~/.kiwami-staging/ ~/kiwami/ \
            && rm -rf ~/.kiwami-staging'
    @./scripts/vmssh 'find ~/kiwami -type f | sort | sed "s|/home/nixos/kiwami/|  |"'

# Push, then nixos-rebuild switch inside the guest
rebuild HOST="vm-aarch64": push
    @./scripts/vmssh 'sudo nixos-rebuild switch --flake ~/kiwami#{{HOST}}'

# Evaluate the config on the HOST (no VM needed, catches option errors fast)
eval HOST="vm-aarch64":
    @cd .. && nix eval --raw .#nixosConfigurations.{{HOST}}.config.system.build.toplevel.drvPath && echo ""

# Update flake inputs and re-lock (run on the host)
update:
    @cd .. && nix flake update

# --- driving -----------------------------------------------------------

# Run a command in the guest over ssh:  just ssh 'uname -a'
ssh +CMD:
    @./scripts/vmssh {{quote(CMD)}}

# Interactive shell in the guest
shell:
    @./scripts/vmssh

# Run a command over the serial console (works before ssh is up)
run +CMD:
    @python3 scripts/console.py run {{quote(CMD)}}

# Log in at the serial getty prompt
console-login:
    @python3 scripts/console.py login

# Wait for text to appear on the serial console:  just expect 'kiwami-vm login'
expect +TEXT:
    @python3 scripts/console.py expect {{quote(TEXT)}}

# Send a single keystroke via QMP:  just key ctrl-alt-f2
key +KEYS:
    @python3 scripts/qmp.py key {{KEYS}}

# --- desktop -----------------------------------------------------------

# Run hyprctl in the guest. The signature comes from the systemd user
# environment, which is what UWSM finalizes it into. The other candidates are
# both wrong: /run/user/*/hypr keeps stale dirs from previous sessions, and
# the compositor's own /proc environ holds the value it INHERITED at exec,
# before it published the real one.
hyprctl +ARGS:
    @./scripts/vmssh 'export XDG_RUNTIME_DIR=/run/user/1000; \
        export HYPRLAND_INSTANCE_SIGNATURE=$(systemctl --user show-environment \
            | sed -n "s/^HYPRLAND_INSTANCE_SIGNATURE=//p"); \
        hyprctl {{ARGS}}'

# Restart the shell. Required after a push: the file watcher is disabled on
# purpose, so the shell only picks up a tree we know is complete.
restart-shell:
    @./scripts/vmssh 'export XDG_RUNTIME_DIR=/run/user/1000; \
        systemctl --user restart kiwami-shell.service' && echo "shell restarted"

# Shell logs
shell-log N="30":
    @./scripts/vmssh 'journalctl --user -u kiwami-shell.service --no-pager -n {{N}}'

# Push the working tree, reload Hyprland and restart the shell. No rebuild:
# configs are out-of-store symlinks, so this is the whole edit->see-it loop.
reload: push restart-shell
    @./scripts/vmssh 'export XDG_RUNTIME_DIR=/run/user/1000; \
        export HYPRLAND_INSTANCE_SIGNATURE=$(systemctl --user show-environment \
            | sed -n "s/^HYPRLAND_INSTANCE_SIGNATURE=//p"); \
        hyprctl reload'

# Restart the Hyprland session (greetd)
restart-session:
    @./scripts/vmssh 'sudo systemctl restart greetd' && echo "session restarted"

# Apply a theme (regenerates ghostty/hyprland files, retints everything)
theme NAME="kiwami": push
    @./scripts/vmssh 'kiwami theme set {{NAME}}'

# List themes, marking the active one
themes:
    @./scripts/vmssh 'kiwami theme list'

# --- observing ---------------------------------------------------------

# Capture the framebuffer:  just screenshot bar
screenshot NAME="screen":
    @mkdir -p screenshots
    @python3 scripts/qmp.py screenshot screenshots/{{NAME}}.png

# Tail the serial log
logs N="40":
    @tail -c 8000 serial.log | sed 's/\x1b\[[0-9;?]*[a-zA-Z]//g' | tail -{{N}}

# --- snapshots ---------------------------------------------------------

# List disk snapshots
snaps:
    @./scripts/snapshot.sh list

# Save a snapshot (VM must be stopped):  just snap clean
snap TAG:
    @./scripts/snapshot.sh save {{TAG}}

# Restore a snapshot (VM must be stopped):  just restore installed
restore TAG:
    @./scripts/snapshot.sh restore {{TAG}}

# Stop, restore the 'installed' snapshot, boot again
reset: stop (restore "installed") start

# --- housekeeping ------------------------------------------------------

# Remove screenshots and serial log
clean:
    @rm -f screenshots/*.png serial.log && echo "cleaned"

# Also remove the disk image and UEFI vars (keeps the ISO)
clean-disk: stop
    @rm -f disks/kiwami.qcow2 disks/edk2-vars.fd && echo "disk removed"
